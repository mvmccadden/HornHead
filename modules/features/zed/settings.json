{
  "vim_mode": true,
  "base_keymap": "Zed",

  "ui_font_size": 12,
  "buffer_font_size": 12,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 12
  },

  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine Moon"
  },

  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "auto_indent": "syntax_aware",
  "ensure_final_newline_on_save": true,
  "format_on_save": "off",
  "autosave": "off",

  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
    "folds": true
  },
  "project_panel": {
    "dock": "left",
    "default_width": 320
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right"
  },
  "scrollbar": {
    "show": "never"
  },
  "scroll_beyond_last_line": "off",
  "cursor_blink": false,
  "current_line_highlight": "line",
  "confirm_quit": false,
  "close_panel_on_toggle": true,

  "which_key": {
    "enabled": true
  },

  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "use_regex_search": true,
    "gdefault": false,
    "toggle_relative_line_numbers": false,
    "highlight_on_yank_duration": 200
  },

  "languages": {
    "C": {
      "format_on_save": "on"
    },
    "C++": {
      "format_on_save": "on"
    }
  },

  "auto_install_extensions": {
    "nix": true,
    "toml": true,
    "dockerfile": true,
    "docker-compose": true,
    "gdscript": true,
    "lua": true,
    "rose-pine-theme": true
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
