[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f r": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space f s": "project_symbols::Toggle",

      "space w v": "pane::SplitRight",
      "space w V": "pane::SplitDown",
      "space w d": ["pane::CloseActiveItem", { "close_pinned": false }],
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w H": "workspace::SwapPaneLeft",
      "space w J": "workspace::SwapPaneDown",
      "space w K": "workspace::SwapPaneUp",
      "space w L": "workspace::SwapPaneRight",
      "space w =": "pane::IncreaseFontSize",
      "space w -": "pane::DecreaseFontSize",
      "space w z": "workspace::ToggleEditorZoom",

      "space t a": "agent::ToggleFocus",
      "space t h": "agents_sidebar::ToggleThreadSwitcher",
      "space t t": "terminal_panel::ToggleFocus",
      "space t p": "project_panel::ToggleFocus",
      "space t g": "git_panel::ToggleFocus",
      "space t m": "diagnostics::Deploy",
      "space t o": "outline_panel::ToggleFocus",
      "space t d": "debug_panel::ToggleFocus",
      "space t c": "collab_panel::ToggleFocus",
      "space t e": "zed::Extensions",

      "space c f": "editor::Format",
      "space r l": "editor::RestartLanguageServer",

      "space s l": "diagnostics::Deploy",
      "space s d": "editor::Hover",

      "space s r": "buffer_search::DeployReplace",
      "space v l": "editor::SelectLine",

      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-t": "terminal_panel::ToggleFocus",
      "ctrl-g": "git_panel::ToggleFocus",
      "ctrl-a": "agent::ToggleFocus",
      "ctrl-shift-a": "agents_sidebar::ToggleThreadSwitcher",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-w-z": "workspace::ToggleEditorZoom",
      "ctrl-shift-h": "workspace::SwapPaneLeft",
      "ctrl-shift-j": "workspace::SwapPaneDown",
      "ctrl-shift-k": "workspace::SwapPaneUp",
      "ctrl-shift-l": "workspace::SwapPaneRight"
    }
  },
  {
    "context": "VimControl && !menu && vim_mode == normal",
    "bindings": {
      "s": "pane::SplitVertical",
      "shift-s": "pane::SplitHorizontal"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "%": null,
      "s": "project_panel::OpenSplitVertical",
      "shift-s": "project_panel::OpenSplitHorizontal"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-t": "terminal_panel::ToggleFocus",
      "ctrl-g": "git_panel::ToggleFocus",
      "ctrl-a": "agent::ToggleFocus",
      "ctrl-shift-a": "agents_sidebar::ToggleThreadSwitcher"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == insert && showing_completions",
    "bindings": {
      "tab": "editor::ConfirmCompletion",
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrevious"
    }
  }
]
